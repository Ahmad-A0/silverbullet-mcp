# SilverBullet MCP Server Environment Configuration

# Required: Authentication token for MCP clients
# This token is required for security - generate a strong, unique token (i.e openssl rand -base64 48)
MCP_TOKEN=your-secure-mcp-token-here

# Authentication token for SilverBullet API
# For multi-space servers, use a Dashboard-issued API token with access to the space.
# This is separate from MCP_TOKEN.
SB_AUTH_TOKEN=your-silverbullet-token-here

# Optional: Full SilverBullet space URL, including its configured path prefix.
# For example: http://silverbullet:3000/work (do not append /.fs)
# Optional: SilverBullet API base URL
# Default is suitable for Docker Compose setup
# SB_API_BASE_URL=http://silverbullet:3000

# Optional: Port for MCP server
# Default is 4000
# PORT=4000

# Optional: Enable request debugging
# DEBUG_REQUESTS=false

# Optional: Override the bundled SilverBullet image (legacy single-space example)
# SILVERBULLET_IMAGE=ghcr.io/silverbulletmd/silverbullet:2.11.0-slim
